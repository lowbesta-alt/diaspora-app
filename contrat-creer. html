<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Créer un contrat - Admin</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gradient-to-br from-slate-900 via-slate-800 to-emerald-950 min-h-screen text-white pb-20">

  <header class="sticky top-0 z-40 bg-slate-900/80 backdrop-blur-md border-b border-slate-700/50 px-4 py-3 flex items-center justify-between">
    <a href="contrats.html" class="text-2xl">←</a>
    <span class="font-bold text-sm">Créer un contrat</span>
    <span class="w-6"></span>
  </header>

  <main class="p-4 max-w-2xl mx-auto space-y-4">

    <div class="bg-amber-500/10 border border-amber-500/30 rounded-2xl p-3 flex items-start gap-3">
      <span class="text-lg">🛡️</span>
      <p class="text-xs text-amber-200">Vous créez un contrat au nom de l'administration. Les deux parties devront le signer.</p>
    </div>

    <section class="bg-white/5 border border-white/10 rounded-2xl p-4 space-y-3">
      <div>
        <label class="text-xs font-semibold text-slate-300 mb-2 block">Titre du contrat *</label>
        <input type="text" id="title" placeholder="Ex : Contrat de prestation Villa Kribi" class="w-full bg-slate-800/50 border border-white/10 rounded-xl px-3 py-3 text-sm focus:outline-none focus:border-emerald-500">
      </div>

      <div>
        <label class="text-xs font-semibold text-slate-300 mb-2 block">Type de contrat</label>
        <select id="contractType" class="w-full bg-slate-800/50 border border-white/10 rounded-xl px-3 py-3 text-sm focus:outline-none focus:border-emerald-500">
          <option value="Prestation">Prestation de services</option>
          <option value="Construction">Construction / BTP</option>
          <option value="Rénovation">Rénovation</option>
          <option value="Maintenance">Maintenance</option>
          <option value="Avenant">Avenant</option>
          <option value="Autre">Autre</option>
        </select>
      </div>

      <div>
        <label class="text-xs font-semibold text-slate-300 mb-2 block">Projet associé</label>
        <select id="project" class="w-full bg-slate-800/50 border border-white/10 rounded-xl px-3 py-3 text-sm focus:outline-none focus:border-emerald-500">
          <option value="">Chargement...</option>
        </select>
      </div>
    </section>

    <section class="bg-white/5 border border-white/10 rounded-2xl p-4 space-y-3">
      <div>
        <label class="text-xs font-semibold text-slate-300 mb-2 block">Investisseur (client) *</label>
        <select id="investor" class="w-full bg-slate-800/50 border border-white/10 rounded-xl px-3 py-3 text-sm focus:outline-none focus:border-emerald-500">
          <option value="">Chargement...</option>
        </select>
      </div>

      <div>
        <label class="text-xs font-semibold text-slate-300 mb-2 block">Prestataire (artisan) *</label>
        <select id="provider" class="w-full bg-slate-800/50 border border-white/10 rounded-xl px-3 py-3 text-sm focus:outline-none focus:border-emerald-500">
          <option value="">Chargement...</option>
        </select>
      </div>
    </section>

    <section class="bg-white/5 border border-white/10 rounded-2xl p-4 space-y-3">
      <div>
        <label class="text-xs font-semibold text-slate-300 mb-2 block">Montant total (XAF)</label>
        <input type="number" id="amount" placeholder="Ex : 40000000" class="w-full bg-slate-800/50 border border-white/10 rounded-xl px-3 py-3 text-sm focus:outline-none focus:border-emerald-500">
      </div>

      <div>
        <label class="text-xs font-semibold text-slate-300 mb-2 block">Contenu du contrat (optionnel)</label>
        <p class="text-[10px] text-slate-400 mb-2">Laissez vide pour utiliser le modèle standard.</p>
        <textarea id="content" rows="6" placeholder="Collez ici le texte du contrat si vous voulez un contenu personnalisé…" class="w-full bg-slate-800/50 border border-white/10 rounded-xl px-3 py-3 text-sm focus:outline-none focus:border-emerald-500 resize-none"></textarea>
      </div>
    </section>

    <section class="flex gap-2">
      <a href="contrats.html" class="flex-1 bg-white/5 border border-white/10 py-3 rounded-xl font-semibold text-sm text-center">Annuler</a>
      <button id="btn-create" class="flex-1 bg-emerald-600 hover:bg-emerald-700 py-3 rounded-xl font-semibold text-sm">Créer le contrat</button>
    </section>

  </main>

  <script src="config.js"></script>
  <script src="app.js"></script>
  <script>
    if (!requireLogin()) throw new Error('Not logged');
    if (getCurrentUserRole() !== 'admin') {
      alert('Accès réservé à l\'administrateur');
      window.location.href = 'contrats.html';
    }

    async function loadProjects() {
      const select = document.getElementById('project');
      try {
        const data = await apiGet('projects', 'order=created_at.desc');
        const valid = Array.isArray(data) ? data : [];
        select.innerHTML = '<option value="">Aucun projet</option>' +
          valid.map(p => '<option value="' + p.id + '">' + escapeHtml(p.title) + '</option>').join('');
      } catch (e) {
        select.innerHTML = '<option value="">Erreur</option>';
      }
    }

    async function loadUsers() {
      try {
        const data = await apiGet('profiles', 'order=full_name.asc&limit=200');
        const users = Array.isArray(data) ? data : [];

        const investors = users.filter(u => u.default_role === 'investor' || u.default_role === 'admin');
        const providers = users.filter(u => u.default_role === 'provider' || u.default_role === 'project_manager');

        document.getElementById('investor').innerHTML = '<option value="">Sélectionner…</option>' +
          investors.map(u => '<option value="' + u.id + '">' + escapeHtml(u.full_name || u.email) + '</option>').join('');

        document.getElementById('provider').innerHTML = '<option value="">Sélectionner…</option>' +
          providers.map(u => '<option value="' + u.id + '">' + escapeHtml(u.full_name || u.email) + '</option>').join('');
      } catch (e) {
        console.error('[loadUsers]', e);
      }
    }

    document.getElementById('btn-create').addEventListener('click', async () => {
      const title = document.getElementById('title').value.trim();
      const contractType = document.getElementById('contractType').value;
      const projectId = document.getElementById('project').value;
      const investorId = document.getElementById('investor').value;
      const providerId = document.getElementById('provider').value;
      const amount = document.getElementById('amount').value;
      const content = document.getElementById('content').value.trim();

      if (!title) { alert('Entrez un titre'); return; }
      if (!investorId) { alert('Sélectionnez l\'investisseur'); return; }
      if (!providerId) { alert('Sélectionnez le prestataire'); return; }
      if (investorId === providerId) { alert('Investisseur et prestataire doivent être différents'); return; }

      const btn = document.getElementById('btn-create');
      btn.disabled = true;
      btn.textContent = 'Création...';

      const payload = {
        title: title,
        contract_type: contractType,
        party_investor_id: investorId,
        party_provider_id: providerId,
        status: 'pending_signature',
        created_at: new Date().toISOString()
      };

      if (projectId) payload.project_id = projectId;
      if (amount) payload.total_amount = Number(amount);
      if (content) payload.content = content;

      try {
        try {
          await apiPost('contracts', payload);
        } catch (err) {
          console.warn('[create] retry minimal', err);
          await apiPost('contracts', {
            title: title,
            contract_type: contractType,
            party_investor_id: investorId,
            party_provider_id: providerId,
            status: 'pending_signature'
          });
        }

        showSuccess('Contrat créé !');
        setTimeout(() => { window.location.href = 'contrats.html'; }, 800);

      } catch (e) {
        console.error('[create]', e);
        showError(e.message || 'Erreur création');
        btn.disabled = false;
        btn.textContent = 'Créer le contrat';
      }
    });

    loadProjects();
    loadUsers();
  </script>
</body>
</html>
